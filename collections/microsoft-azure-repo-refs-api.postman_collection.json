      "name": "Refs",
      "description": {
        "content": "Operations for managing branches and tags (refs) including listing, creating, updating, and deleting refs.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "507f4046-5cba-4328-89f8-76591037629e",
          "name": "Azure Repos List refs (branches and tags)",
          "request": {
            "name": "Azure Repos List refs (branches and tags)",
            "description": {
              "content": "Retrieve all refs (branches and tags) for a repository. Supports filtering by name prefix, peeling tags to their target objects, and including statuses such as build and policy check results.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "git",
                "repositories",
                ":repositoryId",
                "refs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "Filter refs by name prefix (e.g., heads/main, tags/v1)"
                },
                {
                  "disabled": false,
                  "key": "includeLinks",
                  "value": "<boolean>",
                  "description": "Include reference links in the response"
                },
                {
                  "disabled": false,
                  "key": "includeStatuses",
                  "value": "<boolean>",
                  "description": "Include status information for each ref"
                },
                {
                  "disabled": false,
                  "key": "includeMyBranches",
                  "value": "<boolean>",
                  "description": "Include only branches owned by the authenticated user"
                },
                {
                  "disabled": false,
                  "key": "peelTags",
                  "value": "<boolean>",
                  "description": "Annotated tags will populate the PeeledObjectId property"
                },
                {
                  "disabled": false,
                  "key": "$top",
                  "value": "<integer>",
                  "description": "Maximum number of refs to return"
                },
                {
                  "disabled": false,
                  "key": "continuationToken",
                  "value": "<string>",
                  "description": "Continuation token for paging through results"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "repositoryId",
                  "description": "(Required) The ID or name of the repository"
                },
                {
                  "description": "The name of the Azure DevOps organization",
                  "type": "any",
                  "value": "{{organization}}",
                  "key": "organization"
                },
                {
                  "description": "Project ID or project name",
                  "type": "any",
                  "value": "{{project}}",
                  "key": "project"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
