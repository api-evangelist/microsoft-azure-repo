      "name": "Commits",
      "description": {
        "content": "Operations for accessing commit details and commit history within a repository, including diffs and changes.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "756c7d3b-b547-4639-96ef-7d58a9d91a7c",
          "name": "Azure Repos List commits",
          "request": {
            "name": "Azure Repos List commits",
            "description": {
              "content": "Retrieve commit history for a repository. Supports filtering by branch, author, date range, item path, and various search criteria. Results are ordered by commit date descending.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "git",
                "repositories",
                ":repositoryId",
                "commits"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "searchCriteria.itemVersion.version",
                  "value": "<string>",
                  "description": "Branch name or tag to search (e.g., main, develop)"
                },
                {
                  "disabled": false,
                  "key": "searchCriteria.itemVersion.versionType",
                  "value": "<string>",
                  "description": "Type of version identifier"
                },
                {
                  "disabled": false,
                  "key": "searchCriteria.itemPath",
                  "value": "<string>",
                  "description": "Path of an item to filter commits that changed this path"
                },
                {
                  "disabled": false,
                  "key": "searchCriteria.fromDate",
                  "value": "<dateTime>",
                  "description": "Start date for filtering commits"
                },
                {
                  "disabled": false,
                  "key": "searchCriteria.toDate",
                  "value": "<dateTime>",
                  "description": "End date for filtering commits"
                },
                {
                  "disabled": false,
                  "key": "searchCriteria.author",
                  "value": "<string>",
                  "description": "Filter by author name or email"
                },
                {
                  "disabled": false,
                  "key": "searchCriteria.$top",
                  "value": "<integer>",
                  "description": "Maximum number of commits to return"
                },
                {
                  "disabled": false,
                  "key": "searchCriteria.$skip",
                  "value": "<integer>",
                  "description": "Number of commits to skip"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "repositoryId",
                  "description": "(Required) The ID or name of the repository"
                },
                {
                  "description": "The name of the Azure DevOps organization",
                  "type": "any",
                  "value": "{{organization}}",
                  "key": "organization"
                },
                {
                  "description": "Project ID or project name",
                  "type": "any",
                  "value": "{{project}}",
                  "key": "project"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
